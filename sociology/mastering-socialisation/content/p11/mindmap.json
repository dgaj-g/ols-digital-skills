      "h": "Social control",
      "list": [
        "Formal: given by an organisation with written rules",
        [
          "Positive: graduation ceremony, merit, promotion",
          "Negative: prison sentence, detention, court fine"
        ],
        "Informal: given by anyone in everyday life",
        [
          "Positive: a pat on the back, ‘Well done’",
          "Negative: time-out at home, being left out of a group"
        ]
