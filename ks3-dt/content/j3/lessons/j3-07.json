 "title": "Teach It To See",
 "tagline": "You teach your computer to know your drawings. Then you find out how it goes wrong.",
 "mode": "taught",
 "type": "story-hour",
 "artefact": "card",
 "durationMin": 60,
 "objectives": [
  "Teach a computer to tell two things apart by giving it examples.",
  "Say why a computer gets another person’s drawings wrong.",
  "Show that a computer can be wrong even when it is very sure.",
  "Say when a person should check a computer’s answer."
 ],
 "exit": {
  "items": [
   {
    "id": "j3x7-1",
    "stem": "Nobody told your computer what a sun is. How does it know one?",
    "options": [
     "It compares your new drawing with the drawings it was given",
     "Someone typed in the rules for a sun",
     "It looks up the word sun on the internet",
     "It understands what the sun is"
    ]
   },
   {
    "id": "j3x7-2",
    "stem": "Your computer knew your drawings but got another person's wrong. Why?",
    "options": [
     "It had only learned from the way one person draws",
     "The other person drew too slowly",
     "The computer was tired by then",
     "The other person used a different mouse"
    ]
   },
   {
    "id": "j3x7-3",
    "stem": "You drew a cat. Your computer named it, and it was very sure. What does that show?",
    "options": [
     "A computer can be very sure and still be wrong",
     "A cat is a kind of sun or fish",
     "It knew it was a cat but did not say",
     "When it is very sure it is always right"
    ]
   },
   {
    "id": "j3x7-4",
    "stem": "What made your computer better at another person's drawings?",
    "options": [
     "Giving it more examples, drawn by more people",
     "Drawing the same sun again, more slowly",
     "Turning the computer off and on again",
     "Telling it to try harder"
    ]
   },
   {
    "id": "j3x7-5",
    "stem": "A hospital uses a computer like yours to read X-rays. When should a person check its answer?",
    "options": [
     "When the computer is not very sure of its answer",
     "Never, because computers do not make mistakes",
     "Only when the computer is switched off",
     "Only on the first day it is used"
    ]
   }
  ]
 },
