/* ============================================================
 * OLS KS3 DT — Teacher Slide Decks generator
 * ------------------------------------------------------------
 * Creates the Lesson 1 teacher deck straight into Damien's Google Drive,
 * in the folder "KS3 DT Teacher Slide Decks", shared read-only so any
 * teacher can open it without requesting access.
 *
 * TO RUN (one time, needs your authorisation):
 *   1. Pick the function  run  in the toolbar dropdown.
 *   2. Press Run. Google will ask you to authorise — allow it.
 *   3. Open the Execution log: it prints the deck's open link and its
 *      make-your-own-copy link.
 *
 * Scales to all 51 lessons: add a new entry to DECKS and run again.
 * Consent screenshots are embedded below with pupil name/email redacted.
 * ============================================================ */

var BRAND = {
  navy: '#1A3A6B', gold: '#E4B824', tint: '#F4F6FA',
  ink: '#17223B', white: '#FFFFFF', font: 'Calibri'
};
var FOLDER_NAME = 'KS3 DT Teacher Slide Decks';
var W = 720, H = 405;

function run() {
  var out = buildDeck_('j1-01');
  Logger.log('================ DECK READY ================');
  Logger.log('Open (read-only for all teachers): ' + out.viewUrl);
  Logger.log('Make-your-own-copy link:           ' + out.copyUrl);
  Logger.log('Sharing: ' + out.sharing);
  Logger.log('============================================');
}

function buildDeck_(lessonId) {
  var spec = DECKS[lessonId];
  if (!spec) throw new Error('No deck spec for ' + lessonId);

  var folder;
  var it = DriveApp.getFoldersByName(FOLDER_NAME);
  folder = it.hasNext() ? it.next() : DriveApp.createFolder(FOLDER_NAME);

  // Never overwrite an existing deck: if one with this name exists, report it.
  var existing = folder.getFilesByName(spec.name);
  if (existing.hasNext()) {
    var ex = existing.next();
    return {
      viewUrl: 'https://docs.google.com/presentation/d/' + ex.getId() + '/edit',
      copyUrl: 'https://docs.google.com/presentation/d/' + ex.getId() + '/copy',
      sharing: 'already existed — untouched. Rename or bin it first if you want a rebuild.'
    };
  }

  var pres = SlidesApp.create(spec.name);
  var firstSlide = pres.getSlides()[0];

  spec.slides.forEach(function (s) {
    var slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
    if (s.type === 'title') titleSlide_(slide, s);
    if (s.type === 'bullets') bulletSlide_(slide, s);
    if (s.type === 'step') stepSlide_(slide, s);
    if (s.type === 'closer') closerSlide_(slide, s);
    if (s.notes) slide.getNotesPage().getSpeakerNotesShape().getText().setText(s.notes);
  });
  firstSlide.remove();

  var file = DriveApp.getFileById(pres.getId());
  file.moveTo(folder);

  var sharing;
  try {
    file.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW);
    sharing = 'anyone at c2ken.net with the link can view';
  } catch (e) {
    try {
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      sharing = 'anyone with the link can view';
    } catch (e2) {
      sharing = 'AUTOMATIC SHARING FAILED — open the deck, press Share, and set link access to Viewer yourself. (' + e2 + ')';
    }
  }
  return {
    viewUrl: 'https://docs.google.com/presentation/d/' + pres.getId() + '/edit',
    copyUrl: 'https://docs.google.com/presentation/d/' + pres.getId() + '/copy',
    sharing: sharing
  };
}

/* ---------------- slide builders (OLS house style) ---------------- */

function box_(slide, x, y, w, h, color) {
  var r = slide.insertShape(SlidesApp.ShapeType.RECTANGLE, x, y, w, h);
  r.getFill().setSolidFill(color);
  r.getBorder().setTransparent();
  return r;
}

function text_(slide, str, x, y, w, h, opts) {
  var t = slide.insertTextBox(str, x, y, w, h);
  var tr = t.getText();
  var st = tr.getTextStyle();
  st.setFontFamily(BRAND.font).setFontSize(opts.size || 18).setForegroundColor(opts.color || BRAND.ink);
  if (opts.bold) st.setBold(true);
  if (opts.align) tr.getParagraphStyle().setParagraphAlignment(opts.align);
  if (opts.middle) t.setContentAlignment(SlidesApp.ContentAlignment.MIDDLE);
  if (opts.spacing) tr.getParagraphStyle().setLineSpacing(opts.spacing);
  return t;
}

function chrome_(slide, heading) {
  box_(slide, 0, 0, W, 62, BRAND.navy);
  box_(slide, 0, 62, W, 5, BRAND.gold);
  text_(slide, heading, 28, 8, W - 56, 46, { size: 24, color: BRAND.white, bold: true, middle: true });
  box_(slide, 0, H - 26, W, 26, BRAND.navy);
  text_(slide, "Our Lady's Grammar School · Digital Technology · Lesson 1", 0, H - 25, W, 22,
    { size: 10, color: BRAND.gold, align: SlidesApp.ParagraphAlignment.CENTER });
}

function titleSlide_(slide, s) {
  box_(slide, 0, 0, W, H, BRAND.navy);
  box_(slide, 60, 218, 240, 4, BRAND.gold);
  text_(slide, s.kicker, 60, 118, 560, 30, { size: 14, color: BRAND.gold, bold: true });
  text_(slide, s.title, 60, 148, 600, 66, { size: 40, color: BRAND.white, bold: true });
  text_(slide, s.sub, 60, 234, 560, 60, { size: 16, color: '#CFE0FF' });
  try {
    var img = slide.insertImage(blob_('crest'));
    var w = 92, h = 92 * (img.getHeight() / img.getWidth());
    img.setLeft(W - w - 44).setTop(40).setWidth(w).setHeight(h);
  } catch (e) {}
}

function bulletSlide_(slide, s) {
  box_(slide, 0, 0, W, H, BRAND.white);
  chrome_(slide, s.heading);
  var t = text_(slide, s.bullets.join('\n'), 44, 86, W - 88, H - 86 - 34, { size: s.size || 17, spacing: 118 });
  t.getText().getListStyle().applyListPreset(SlidesApp.ListPreset.DISC_CIRCLE_SQUARE);
  t.getText().getParagraphStyle().setSpaceBelow(10);
}

function stepSlide_(slide, s) {
  box_(slide, 0, 0, W, H, BRAND.tint);
  chrome_(slide, s.heading);
  try {
    var img = slide.insertImage(blob_(s.img));
    var maxH = H - 62 - 5 - 26 - 24, maxW = 300;
    var ratio = img.getWidth() / img.getHeight();
    var h = maxH, w = h * ratio;
    if (w > maxW) { w = maxW; h = w / ratio; }
    img.setLeft(44).setTop(62 + 5 + 12).setWidth(w).setHeight(h);
  } catch (e) {}
  text_(slide, s.text, 380, 120, W - 380 - 44, 200, { size: 19, spacing: 122, middle: false });
}

function closerSlide_(slide, s) {
  box_(slide, 0, 0, W, H, BRAND.navy);
  text_(slide, s.title, 0, 96, W, 56, { size: 40, color: BRAND.gold, bold: true, align: SlidesApp.ParagraphAlignment.CENTER });
  text_(slide, s.bullets.join('\n'), 130, 172, W - 260, 150, { size: 19, color: BRAND.white, spacing: 130 });
  text_(slide, s.sub, 0, H - 66, W, 30, { size: 14, color: '#CFE0FF', align: SlidesApp.ParagraphAlignment.CENTER });
}

function blob_(key) {
  var im = IMAGES[key];
  return Utilities.newBlob(Utilities.base64Decode(im.data), im.mime, key);
}

